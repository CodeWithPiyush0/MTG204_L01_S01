  "audio_text": {
   "vo_landing": "नमस्ते दोस्त! मैं हूँ स्विफ्टी। परी के स्कूल में पिकनिक होने वाली है। उसे पिकनिक के लिए कुछ सामान खरीदना है। चलिए, उसकी मदद करते हैं!",
   "vo_pt_mastery": "चलिए, अब खरीदारी का खेल खेलते हैं!",
   "vo_t1_prompt": "बाज़ार जाने से पहले, आइए पहचानते हैं कि दस रुपये और एक रुपये कैसे दिखते हैं।",
   "vo_t2_prompt": "इनमें से दस रुपये का नोट पहचानिए।",
   "vo_t2_correct": "शाबाश! यह दस रुपये का नोट है।",
   "vo_t2_wrong": "यह दस रुपये का नोट है।",
   "vo_t3_prompt": "इनमें से एक रुपये का सिक्का कौन सा है?",
   "vo_t3_correct": "शाबाश! यह एक रुपये का सिक्का है।",
   "vo_t3_wrong": "यह एक रुपये का सिक्का है। एक रुपये का सिक्का ऐसा दिखता है।",
   "vo_t4_prompt": "परी अपनी खरीदारी की सूची लेकर बाज़ार पहुँच गई है। आइए देखें, उसे क्या-क्या खरीदना है।",
   "vo_g1_prompt": "परी को कॉपी, चिप्स, चॉकलेट, प्लेटें और टॉफ़ी खरीदनी हैं। चलो, दस रुपये और एक रुपये से हर चीज़ की राशि बनाते हैं।",
   "vo_g2_done": "शाबाश! एक दस रुपये का नोट और चार एक रुपये के सिक्के, कुल मिलाकर बने चौदह रुपये।",
   "vo_g2_1": "सबसे पहले परी को चौदह रुपये की कॉपी लेनी है। आइए, दस रुपये और एक रुपये से चौदह रुपये बनाते हैं।",
   "vo_g2_2": "पहले दस रुपये का एक नोट रखते हैं।",
   "vo_g2_3": "अभी कुल दस रुपये हुए। चौदह रुपये बनाने के लिए अभी चार रुपये और चाहिए।",
   "vo_g2_5": "चलो, अब तुम रखो।",
   "vo_g2_idle": "सिक्के को ऊपर वाली ट्रे में रखिए।",
