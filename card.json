  "audio_text": {
   "vo_landing": "नमस्ते दोस्त! मैं हूँ स्विफ्टी। आज परी बाज़ार जा रही है। उसे कुछ सामान खरीदना है। आइए, हम भी उसके साथ चलते हैं और उसकी मदद करते हैं।",
   "vo_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
   "vo_sort_done": "शाबाश!",
   "vo_t1_note": "यह दस रुपये का नोट है।",
   "vo_t1_coin": "और यह एक रुपये का सिक्का है।",
   "vo_g1_prompt": "चलिए, दस रुपये छाँटते हैं।",
   "vo_g2_prompt": "चलिए, एक रुपये के सिक्के छांटिए।",
   "vo_b14_prompt": "दस रुपये और एक रुपये से चौदह रुपये बनाइए।",
   "vo_g2_done": "शाबाश! एक दस रुपये का नोट और चार एक रुपये के सिक्के, कुल मिलाकर बने चौदह रुपये।",
   "vo_b14_intro": "चलिए, दस रुपये और एक रुपये के सिक्कों से इस राशि को बनाते हैं।",
   "vo_b32_prompt": "दस रुपये और एक रुपये से बत्तीस रुपये बनाइए।",
   "vo_b32_done": "शाबाश! तीन दस रुपये के नोट और दो एक रुपये के सिक्के, कुल मिलाकर बने बत्तीस रुपये।",
   "vo_hint_ones_1": "ध्यान से देखिए! अब एक रुपये का एक सिक्का रखिए।",
   "vo_hint_ones_2": "ध्यान से देखिए! अब एक रुपये के सिक्कों से दो रुपये बनाइए।",
   "vo_b45_prompt": "दस रुपये और एक रुपये से पैंतालीस रुपये बनाइए।",
   "vo_b45_done": "शाबाश! चार दस रुपये के नोट और पाँच एक रुपये के सिक्के, कुल मिलाकर बने पैंतालीस रुपये।",
   "vo_hint_ones_3": "ध्यान से देखिए! अब एक रुपये के सिक्कों से तीन रुपये बनाइए।",
   "vo_hint_ones_4": "ध्यान से देखिए! अब एक रुपये के सिक्कों से चार रुपये बनाइए।",
   "vo_hint_ones_5": "ध्यान से देखिए! अब एक रुपये के सिक्कों से पाँच रुपये बनाइए।",
   "vo_m_sel_apple": "सेब की कीमत चौदह रुपये है। चौदह रुपये बनाइए।",
   "vo_m_sel_oranges": "संतरे की कीमत पच्चीस रुपये है। पच्चीस रुपये बनाइए।",
   "vo_m_ok_oranges": "बहुत बढ़िया!",
   "vo_m_sel_tomatoes": "टमाटर की कीमत पैंतीस रुपये है। पैंतीस रुपये बनाइए।",
   "vo_m_sel_grapes": "अंगूर की कीमत बयालीस रुपये है। बयालीस रुपये बनाइए।",
   "vo_m_sel_bananas": "केले की कीमत साठ रुपये है। साठ रुपये बनाइए।",
   "vo_m_sel_carrots": "गाजर की कीमत पैंसठ रुपये है। पैंसठ रुपये बनाइए।",
   "vo_m_intro": "परी पहुँच गई है बाज़ार। आओ, चलो खरीदारी शुरू करें।",
   "vo_m_prompt": "कोई वस्तु चुनिए और उसकी राशि बनाइए।",
   "vo_m_idle": "कोई वस्तु चुनिए।",
   "vo_m_more1": "ओहो! रुपये ज़्यादा हैं। कुछ कम करिए।",
   "vo_m_less1": "ओहो! रुपये कम हैं। कुछ और डालिए।",
   "vo_m_more2": "ओहो! अभी भी रुपये ज़्यादा हैं। कुछ कम करिए।",
   "vo_m_less2": "ओहो! अभी भी रुपये कम हैं। कुछ और डालिए।",
