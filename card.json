   "vo_p3_t10": "कुल दस रुपये हुए। सत्रह रुपये के लिए सात रुपये और चाहिए।",
   "vo_ones_use_7": "सात रुपये बनाने के लिए एक रुपये के सिक्कों का इस्तेमाल कीजिए।",
   "vo_p3_t11": "कुल ग्यारह रुपये हुए। सत्रह रुपये के लिए छह रुपये और चाहिए।",
   "vo_ones_use_6": "छह रुपये बनाने के लिए एक रुपये के सिक्कों का इस्तेमाल कीजिए।",
   "vo_p3_t12": "कुल बारह रुपये हुए। सत्रह रुपये के लिए पाँच रुपये और चाहिए।",
   "vo_p3_t13": "कुल तेरह रुपये हुए। सत्रह रुपये के लिए चार रुपये और चाहिए।",
   "vo_p3_t14": "कुल चौदह रुपये हुए। सत्रह रुपये के लिए तीन रुपये और चाहिए।",
   "vo_p3_t15": "कुल पंद्रह रुपये हुए। सत्रह रुपये के लिए दो रुपये और चाहिए।",
   "vo_p3_t16": "कुल सोलह रुपये हुए। सत्रह रुपये के लिए एक रुपये और चाहिए।",
   "vo_p3_o7": "कुल सात रुपये हैं। सत्रह रुपये के लिए दस रुपये और बनाओ।",
   "vo_p4_prompt": "शाबाश! आपने दस रुपये और एक रुपये का उपयोग करके सभी धनराशियाँ बनाईं। परी की पिकनिक की खरीदारी पूरी हुई!",
   "vo_m_sel_apple": "सेब की कीमत चौदह रुपये है। चौदह रुपये बनाइए।",
   "vo_m_ok_apple": "शाबाश!",
   "vo_m_sel_oranges": "संतरे की कीमत पच्चीस रुपये है। पच्चीस रुपये बनाइए।",
   "vo_m_ok_oranges": "बहुत बढ़िया!",
   "vo_m_sel_tomatoes": "टमाटर की कीमत पैंतीस रुपये है। पैंतीस रुपये बनाइए।",
   "vo_m_sel_grapes": "अंगूर की कीमत बयालीस रुपये है। बयालीस रुपये बनाइए।",
   "vo_m_sel_bananas": "केले की कीमत साठ रुपये है। साठ रुपये बनाइए।",
   "vo_m_sel_carrots": "गाजर की कीमत पैंसठ रुपये है। पैंसठ रुपये बनाइए।",
   "vo_m_prompt": "कोई वस्तु चुनिए और उसकी राशि बनाइए।",
   "vo_m_idle": "कोई वस्तु चुनिए।",
   "vo_m_less": "ओह! रुपये कम हैं। फिर से बनाइए।",
   "vo_m_more": "ओह! रुपये ज़्यादा हैं। फिर से बनाइए।",
   "vo_m_tip": "कोई पैसा हटाना हो, तो उसे वापस नीचे खींच लीजिए।",
   "vo_m_done": "शाबाश! परी की सारी खरीदारी हो गई।",
   "vo_cel_prompt": "बहुत बढ़िया, दोस्त! तुमने कमाल कर दिया!"
